#!/bin/sh
# Runs before a push. A v* tag becomes a GitHub release whose title is the first
# line of its annotation, so that line has to lead with the version. The release
# script writes it that way; this catches a tag made by hand.
set -e

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac

  tag="${local_ref#refs/tags/}"

  if [ "$(git cat-file -t "$tag" 2>/dev/null)" != "tag" ]; then
    printf '\nRefusing %s: it is a lightweight tag.\n' "$tag" >&2
    printf 'Releases use annotated tags. Cut one with:\n' >&2
    printf '  npm run release -- <patch|minor|major> notes.md\n\n' >&2
    status=1
    continue
  fi

  subject="$(git tag -l "$tag" --format='%(contents:subject)')"
  case "$subject" in
    "$tag"*) ;;
    *)
      printf '\nRefusing %s: the release title has to start with %s.\n' "$tag" "$tag" >&2
      printf 'Got: %s\n' "$subject" >&2
      printf 'Cut one with: npm run release -- <patch|minor|major> notes.md\n\n' >&2
      status=1
      ;;
  esac
done

exit $status
